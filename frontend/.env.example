# Local Docker Compose: Vite dev server proxies /api to the backend container.
VITE_API_PROXY_TARGET=http://backend:8000

# Production (Cloudflare Pages): set in the Pages dashboard build environment.
# Vite embeds this at build time; leave unset for local dev (proxy is used instead).
# VITE_API_BASE_URL=https://couple-simulator.fly.dev
