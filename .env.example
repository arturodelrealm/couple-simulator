POSTGRES_USER=couple
POSTGRES_PASSWORD=couple
POSTGRES_DB=couple_simulator
DATABASE_URL=postgresql+psycopg2://couple:couple@db:5432/couple_simulator
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host ports are mapped in docker-compose.yml (default: API 8001, DB 5433, frontend 5173).
# Change them there if 8000/5432 are free on your machine.
